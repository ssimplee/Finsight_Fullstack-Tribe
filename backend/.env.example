APP_NAME=FinSight API
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./finsight.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Member 4 RAG (retrieval + reasoning) ---
# Enable real RAG in the backend (off by default -> Member 1 mock workflow)
FINSIGHT_USE_RAG=0
# Optional: let Qwen write the differential explanation over retrieved
# evidence (worksplit §5). Off by default; deterministic template otherwise.
FINSIGHT_USE_QWEN_REASONER=0

# --- Qwen (campus AI platform, shared by Member 3 vision + Member 4 reasoner) ---
# API key issued by the campus AI platform
# (see FinSight/智算中心大模型调用方法.docx for the current team key)
QWEN_API_KEY=
# Multimodal/chat model id on the platform
QWEN_MODEL=qwen3-vl-8b
# OpenAI-compatible endpoint (chat/completions appended automatically)
QWEN_BASE_URL=https://model.ai.szu.edu.cn/v1
# Set to false if the campus endpoint certificate cannot be verified
QWEN_VERIFY_SSL=true
