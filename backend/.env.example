APP_NAME=FinSight API
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./finsight.db

# --- Qwen multimodal vision (Member 3) ---
# API key issued by the campus AI platform
# (see FinSight/智算中心大模型调用方法.docx for the current team key)
QWEN_API_KEY=
# Multimodal model id on the platform
QWEN_MODEL=qwen3-vl-8b
# OpenAI-compatible endpoint (chat/completions is appended automatically)
QWEN_BASE_URL=https://model.ai.szu.edu.cn/v1
# Set to false if the campus endpoint certificate cannot be verified
QWEN_VERIFY_SSL=true
# Max number of cached vision results (LRU, keyed by image content hash)
QWEN_CACHE_SIZE=128
